<Window
    x:Class="Inspector.View.PluginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Inspector.View.Behaviours"
    xmlns:local="clr-namespace:Inspector.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControl="clr-namespace:Inspector.View.UserControls"
    xmlns:viewModel="clr-namespace:Inspector.ViewModels"
    Title="{Binding Title}"
    Width="800"
    Height="450"
    MinWidth="400"
    MinHeight="400"
    d:DataContext="{d:DesignInstance viewModel:DesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Inspector;component/Resources/WindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <userControl:SelectedObjectsControl Grid.Row="0" Grid.Column="0" />
        <userControl:DataListBoxControl Grid.Row="0" Grid.Column="1" />
        <Button
            Grid.Row="1"
            Command="{Binding GetSelectedObjects}"
            Content="Get selected" />
    </Grid>
</Window>
