<UserControl
    x:Class="Inspector.View.UserControls.DataListBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bh="clr-namespace:Inspector.View.Behaviours"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Inspector.View.Behaviours"
    xmlns:local="clr-namespace:Inspector.View.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Inspector.ViewModels"
    d:DataContext="{d:DesignInstance viewModel:DesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Inspector;component/Resources/WindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ListView
        bh:ListBoxItemBehaviors.DoubleClickCommand="{Binding RunNewWindow}"
        ItemsSource="{Binding Data}"
        SelectedItem="{Binding SelectedData}">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Name">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource DataTextBox}" Text="{Binding Label, Mode=OneWay}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Value">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource DataTextBox}" Text="{Binding Value, Mode=OneWay}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>

        <!--  Style with DataTrigger  -->
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="LightGray" />
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <!--  Highlight active people  -->
                    <DataTrigger Binding="{Binding IsInterfaceHeader}" Value="True">
                        <Setter Property="Foreground" Value="Green" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <!--  Inactive people  -->
                    <DataTrigger Binding="{Binding IsSubHeader}" Value="True">
                        <Setter Property="Foreground" Value="SaddleBrown" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CanGet}" Value="True">
                        <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ListView.ItemContainerStyle>
    </ListView>
</UserControl>
