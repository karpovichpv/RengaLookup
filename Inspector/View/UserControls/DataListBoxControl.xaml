<UserControl
    x:Class="Inspector.View.UserControls.DataListBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Inspector.View.Behaviours"
    xmlns:local="clr-namespace:Inspector.View.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Inspector.ViewModels"
    d:DataContext="{d:DesignInstance viewModel:DesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Inspector;component/Resources/WindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ListBox
        Padding="-4,-2,0,0"
        HorizontalAlignment="Stretch"
        i:DataListBoxDoubleClickBehavior.Command="{Binding RunNewWindow}"
        AlternationCount="100"
        BorderThickness="0,1,1,1"
        ItemsSource="{Binding Data}"
        SelectedItem="{Binding SelectedData}">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Style.Triggers>
                    <!--  First item (index 0)  -->
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Margin" Value="-2" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Trigger>

                </Style.Triggers>

                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="-2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="DarkGray" />

            </Style>

        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Margin="0,0,0,1"
                        Padding="2"
                        BorderBrush="DarkGray"
                        BorderThickness="0,0,1,1">
                        <TextBox
                            Grid.Column="0"
                            Style="{StaticResource LabelDataTextBox}"
                            Text="{Binding Label, Mode=OneWay}" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="0,0,0,1"
                        Padding="1"
                        BorderBrush="DarkGray"
                        BorderThickness="0,0,1,1">
                        <TextBox Style="{StaticResource ValueDataTextBox}" Text="{Binding Value, Mode=OneWay}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
